{
  "name": "seedcairn",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "license": "UNLICENSED",
  "scripts": {
    "upgrade:expo": "npx expo install expo@latest && npm upgrade && npx expo install --fix && npx expo-doctor",
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "compile": "tsc",
    "test": "jest",
    "bundle": "npx expo export --platform android --output-dir /tmp/expo-export-check",
    "prep": "npm run lint && npm run compile && npm run test && npm run bundle && npx expo-doctor",
    "development": "npm run development:android && npm run development:ios",
    "development:android": "npm run prep && eas build --profile development --platform android --local",
    "development:ios": "npm run prep && eas build --profile development --platform ios --local",
    "production": "npm run prep && eas build --auto-submit --platform android",
    "production:local": "npm run prep && eas build --profile production --platform android --local"
  },
  "dependencies": {
    "@expo-google-fonts/archivo": "^0.4.2",
    "@expo/ui": "~57.0.9",
    "@noble/hashes": "^2.3.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@scure/bip39": "^2.3.0",
    "expo": "^57.0.16",
    "expo-constants": "~57.0.9",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.14",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-image": "~57.0.2",
    "expo-linking": "~57.0.5",
    "expo-notifications": "~57.0.13",
    "expo-print": "~57.0.1",
    "expo-router": "~57.0.10",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-nfc-manager": "^4.0.0-beta.7",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.4",
    "typescript": "~6.0.3"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-nfc-manager"
        ]
      }
    }
  }
}
